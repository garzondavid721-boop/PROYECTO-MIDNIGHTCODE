services:
  app:
    build:
      context: .  # El contexto es el directorio actual (midnightcode)
      dockerfile: Dockerfile
    container_name: node_app
    restart: unless-stopped
    working_dir: /usr/src/app
    environment:
      DATABASE_URL: mysql://avnadmin:AVNS_muQNM3K88WMh45IMrSs@mysql-39e01649-garzondavid721-91de.e.aivencloud.com:18851/defaultdb?ssl-mode=REQUIRED
      PORT: 3000
      JWT_SECRET: 9fK$2vLmQ8#xT7zP@rW5!uY3cN6*eA1
      JWT_RESET_SECRET: f4K#9mQ2$vL8pX5@zR7wY3cN6*eA1!sH0
      EMAIL_USER: garzondavid720@gmail.com
      EMAIL_PASS: brytholaksdmzmso
      FRONTEND_URL: http://localhost:5173
      NODE_ENV: production
    ports:
      - "3000:3000"

  sonarqube:
    image: sonarqube:lts-community
    container_name: sonarqube
    depends_on:
      - sonarqube_db
    ports:
      - "9000:9000"
    environment:
      SONAR_JDBC_URL: jdbc:postgresql://sonarqube_db:5432/sonar
      SONAR_JDBC_USERNAME: sonar
      SONAR_JDBC_PASSWORD: sonar
    volumes:
      - sonarqube_data:/opt/sonarqube/data
      - sonarqube_logs:/opt/sonarqube/logs
      - sonarqube_extensions:/opt/sonarqube/extensions

  sonarqube_db:
    image: postgres:15
    container_name: sonarqube_db
    restart: unless-stopped
    environment:
      POSTGRES_USER: sonar
      POSTGRES_PASSWORD: sonar
      POSTGRES_DB: sonar
    volumes:
      - postgresql_data:/var/lib/postgresql/data

volumes:
  sonarqube_data:
  sonarqube_logs:
  sonarqube_extensions:
  postgresql_data: